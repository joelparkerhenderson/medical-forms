#!/usr/bin/env python3
"""bin/loco-serve-openapi-refactor — mechanically add a `GET /api/openapi.yaml`
route to every Loco crate, serving that form's combined OpenAPI 3.1 spec
(`openapi/combined/openapi.yaml`, generated by
`bin/openapi/generate-openapi-combined.py`).

Reference implementation: forms/medical-operation-note. A new
`controllers/openapi.rs` — byte-identical across every crate, since it
only depends on the uniform `src/<form_snake_case>/controllers/` nesting
depth, not on the form's own name — `include_str!`s the combined spec at
compile time (so no runtime file path or deployment-time asset copy is
needed) and serves it via Loco's own `format::yaml()` helper. Wired into
each crate the same two mechanical ways as any other scaffold-generated
controller:

  1. `pub mod openapi;` added to `controllers/mod.rs`, right after the
     existing `pub mod auth;` line.
  2. `.add_route(crate::controllers::openapi::routes())` added to
     `app.rs`'s `routes()`, right after `AppRoutes::with_default_routes()`.

Crates missing either anchor line, or missing
`openapi/combined/openapi.yaml` at the expected location, are left
untouched and reported under "SKIP (needs manual handling)".

Usage:
    bin/loco-serve-openapi-refactor [--check] [--dry-run] [--all|<slug>...]

--check reports which crates would change, and exits non-zero if any
change is pending (CI drift detector). --dry-run shows per-crate status
without writing. Default (no flags): apply. Idempotent: a crate already
carrying `controllers/openapi.rs` is left alone.
"""

import argparse
import re
import sys
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parent.parent
FORMS_DIR = REPO_ROOT / "forms"
REFERENCE_FORM = "medical-operation-note"

AUTH_MOD_RE = re.compile(r"^pub mod auth;[ \t]*$", re.MULTILINE)
DEFAULT_ROUTES_RE = re.compile(
    r"^([ \t]*)AppRoutes::with_default_routes\(\)[ \t]*(?://[^\n]*)?$", re.MULTILINE
)

OPENAPI_CONTROLLER = '''//! Serves this form's combined `OpenAPI` 3.1 specification.
#![allow(clippy::missing_errors_doc)]
#![allow(clippy::unused_async)]
use loco_rs::prelude::*;

/// The combined `OpenAPI` 3.1 spec (`openapi/combined/openapi.yaml`,
/// generated by `bin/openapi/generate-openapi-combined.py`), embedded at
/// compile time so no runtime file path or deployment-time asset copy is
/// needed.
const OPENAPI_YAML: &str = include_str!("../../../../openapi/combined/openapi.yaml");

/// Serve the combined `OpenAPI` 3.1 spec for this form's JSON API.
#[debug_handler]
pub async fn get_openapi() -> Result<Response> {
    format::yaml(OPENAPI_YAML)
}

/// Build the route for serving the `OpenAPI` spec.
pub fn routes() -> Routes {
    Routes::new()
        .prefix("api/")
        .add("openapi.yaml", get(get_openapi))
}
'''


def find_crate_src_dirs():
    """One directory per crate: forms/<slug>/back-end-with-loco/src/<form_snake_case>/."""
    for controllers_mod in sorted(FORMS_DIR.glob("*/back-end-with-loco/src/*/controllers/mod.rs")):
        yield controllers_mod.parents[1]  # src/<form_snake_case>/


def process_crate(src_dir: Path) -> tuple[bool, str]:
    form_dir = src_dir.parents[2]  # forms/<slug>/
    mod_path = src_dir / "controllers" / "mod.rs"
    app_path = src_dir / "app.rs"
    openapi_controller_path = src_dir / "controllers" / "openapi.rs"
    openapi_yaml_path = form_dir / "openapi" / "combined" / "openapi.yaml"

    if openapi_controller_path.is_file():
        return False, "already migrated"
    if not openapi_yaml_path.is_file():
        return False, f"SKIP (needs manual handling): no {openapi_yaml_path.relative_to(REPO_ROOT)}"
    mod_text = mod_path.read_text()
    if not AUTH_MOD_RE.search(mod_text):
        return False, "SKIP (needs manual handling): no 'pub mod auth;' in controllers/mod.rs"
    app_text = app_path.read_text()
    if not DEFAULT_ROUTES_RE.search(app_text):
        return False, "SKIP (needs manual handling): no 'AppRoutes::with_default_routes()' in app.rs"
    return True, "changed"


def write_crate(src_dir: Path) -> None:
    mod_path = src_dir / "controllers" / "mod.rs"
    app_path = src_dir / "app.rs"
    openapi_controller_path = src_dir / "controllers" / "openapi.rs"

    openapi_controller_path.write_text(OPENAPI_CONTROLLER)

    mod_text = mod_path.read_text()
    m = AUTH_MOD_RE.search(mod_text)
    mod_text = mod_text[: m.end()] + "\npub mod openapi;" + mod_text[m.end():]
    mod_path.write_text(mod_text)

    app_text = app_path.read_text()
    m = DEFAULT_ROUTES_RE.search(app_text)
    # The chained .add_route(...) calls below AppRoutes::with_default_routes()
    # are indented one level deeper than that statement itself (continuation
    # style) -- match that, not the statement's own indent.
    indent = m.group(1) + "    "
    app_text = (
        app_text[: m.end()]
        + f"\n{indent}.add_route(crate::controllers::openapi::routes())"
        + app_text[m.end():]
    )
    app_path.write_text(app_text)


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("slugs", nargs="*", help="form slugs (default: every form)")
    parser.add_argument("--all", action="store_true", help="same as no slugs: every form")
    parser.add_argument("--check", action="store_true", help="report drift; exit 1 if any pending; don't write")
    parser.add_argument("--dry-run", action="store_true", help="show status per crate; don't write")
    args = parser.parse_args()

    if args.slugs:
        src_dirs = []
        for slug in args.slugs:
            matches = sorted((FORMS_DIR / slug / "back-end-with-loco" / "src").glob("*/"))
            src_dirs.extend(d for d in matches if (d / "controllers" / "mod.rs").is_file())
    else:
        src_dirs = list(find_crate_src_dirs())

    dry = args.check or args.dry_run
    changed = []
    skipped = []
    for src_dir in src_dirs:
        will_change, status = process_crate(src_dir)
        slug = src_dir.parents[2].name
        if will_change:
            changed.append(slug)
            if not dry:
                write_crate(src_dir)
        elif status.startswith("SKIP"):
            skipped.append((slug, status))

    if args.check:
        print(f"loco-serve-openapi-refactor [CHECK]: {len(changed)} crate(s) pending, "
              f"{len(skipped)} SKIP (needs manual handling)")
        for slug in changed:
            print(f"  would change: {slug}")
        return 1 if changed else 0

    verb = "would change" if dry else "changed"
    print(f"loco-serve-openapi-refactor: {len(changed)} crate(s) {verb}, "
          f"{len(skipped)} SKIP (needs manual handling)")
    for slug, status in skipped:
        print(f"  {slug}: {status}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
